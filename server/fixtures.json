{
  "_comment": "Merge cases run against BOTH implementations - Merge.kt and server/merge.js. A merge rule written twice that disagrees with itself loses marks silently, so neither side is allowed to change without this file agreeing.",
  "cases": [
    {
      "name": "two people walking different rooms at once keep both sets of marks",
      "local":  {"marks":{"1115":{"p1":"in","p2":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":1000,"m:1115:p2":1000}},
      "remote": {"marks":{"1115":{"p20":"in","p21":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p20":1001,"m:1115:p21":1001}},
      "expect": {"marks":{"1115":{"p1":"in","p2":"out","p20":"in","p21":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":1000,"m:1115:p2":1000,"m:1115:p20":1001,"m:1115:p21":1001}}
    },
    {
      "name": "a correction made later on another device wins",
      "local":  {"marks":{"1115":{"p1":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":1000}},
      "remote": {"marks":{"1115":{"p1":"in"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":2000}},
      "expect": {"marks":{"1115":{"p1":"in"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":2000}}
    },
    {
      "name": "a later unmark beats an earlier mark",
      "local":  {"marks":{"1115":{"p1":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":1000}},
      "remote": {"marks":{},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":2000}},
      "expect": {"marks":{},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":2000}}
    },
    {
      "name": "a device that never saw a cell does not delete it",
      "local":  {"marks":{"1115":{"p1":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":1000}},
      "remote": {"marks":{},"tonight":[],"notes":{},"closed":false,"ts":{}},
      "expect": {"marks":{"1115":{"p1":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":1000}}
    },
    {
      "name": "excusals, notes and closing all merge by their own timestamps",
      "local":  {"marks":{},"tonight":["p9"],"notes":{"p1":"late"},"closed":false,"ts":{"t:p9":6,"n:p1":7}},
      "remote": {"marks":{},"tonight":[],"notes":{},"closed":true,"ts":{"c":8}},
      "expect": {"marks":{},"tonight":["p9"],"notes":{"p1":"late"},"closed":true,"ts":{"c":8,"n:p1":7,"t:p9":6}}
    },
    {
      "name": "a custom time is just another slot and merges like any other",
      "local":  {"marks":{"0130":{"p1":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:0130:p1":1000}},
      "remote": {"marks":{"0130":{"p2":"in"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:0130:p2":1000}},
      "expect": {"marks":{"0130":{"p1":"out","p2":"in"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:0130:p1":1000,"m:0130:p2":1000}}
    },
    {
      "name": "equal timestamps on the same cell resolve the same way from either side",
      "local":  {"marks":{"1115":{"p1":"in"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":5}},
      "remote": {"marks":{"1115":{"p1":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":5}},
      "expect": {"marks":{"1115":{"p1":"out"}},"tonight":[],"notes":{},"closed":false,"ts":{"m:1115:p1":5}}
    }
  ]
}
