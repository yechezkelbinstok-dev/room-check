            "p1": "in",
            "p2": "out"
          }
        },
        "tonight": [],
        "notes": {},
        "closed": false,
        "ts": {
          "m:1115:p1": 1000,
          "m:1115:p2": 1000
        },
        "slots": [],
        "sheet": []
      },
      "remote": {
        "marks": {
          "1115": {
            "p20": "in",
            "p21": "out"
